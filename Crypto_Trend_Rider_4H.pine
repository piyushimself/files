//@version=5
indicator("Crypto Trend Rider - 4H Trend Following (Large-Cap)", overlay=true, max_labels_count=500)

// ============================================================
// TREND-FOLLOWING system for 4H crypto charts (BTC/ETH + large-cap alts).
// This is a different engine from the monthly ATH breakout suite - it
// does NOT wait for all-time highs. It catches an established trend via
// an EMA stack + ADX/DI strength filter, adds a second leg on a pullback
// bounce while the trend stays intact, scales out a partial profit at a
// fixed R-multiple, and trails the remainder with a Chandelier Exit.
// A full exit (all open legs) fires on EITHER a trend-structure break
// (fast/slow EMA cross-under) OR the trailing stop being hit - whichever
// comes first.
//
// Runs on a 4H chart. Trade decisions are made only after a 4H bar closes.
// The script remains an indicator-based simulation, not a Strategy Tester
// strategy. Fill assumptions are estimates; configure exchange costs below.
// ============================================================

gTrend    = "Trend Filter"
gMomentum = "Momentum / Strength Filter"
gVol      = "Volume Filter"
gPullback = "Pullback Add-On"
gExit     = "Exit / Trailing Stop"
gTarget   = "Partial Profit Target"
gPyramid  = "Pyramiding"
gCapital  = "Capital & Position Sizing"
gCosts    = "Trading Cost Estimates"
gScore    = "Score Thresholds"

emaFastLen  = input.int(21, "Fast EMA", group=gTrend)
emaSlowLen  = input.int(55, "Slow EMA", group=gTrend)
emaMajorLen = input.int(200, "Major Trend EMA", group=gTrend)

adxLen       = input.int(14, "ADX/DI Length", group=gMomentum)
adxThreshold = input.float(20.0, "ADX Threshold (trend strength gate)", group=gMomentum)
rsiLen       = input.int(14, "RSI Length", group=gMomentum)

volAvgLen     = input.int(20, "Volume Average Length", group=gVol)
volMultiplier = input.float(1.2, "Volume Multiplier (vs average)", minval=0.1, step=0.1, group=gVol)

pullbackBandPct = input.float(1.5, "Pullback Zone Above Fast EMA (%)", minval=0.0, group=gPullback,
     tooltip="How close price needs to dip toward the fast EMA (as % above it) to count as a valid pullback for an add-on leg.")

chandelierLen  = input.int(22, "Chandelier Lookback", group=gExit)
chandelierMult = input.float(3.0, "Chandelier ATR Multiplier", group=gExit)
useEmaCrossExit = input.bool(true, "Also Exit on Fast/Slow EMA Cross-Under", group=gExit)

enablePartialTarget = input.bool(true, "Enable Partial Profit Target", group=gTarget)
partialRR   = input.float(2.0, "Partial Target R-Multiple", minval=0.1, group=gTarget)
partialPct  = input.float(50.0, "Qty % to Scale Out at Target", minval=1.0, maxval=100.0, group=gTarget)

maxPyramidLegs = input.int(2, "Max Concurrent Legs", minval=1, maxval=10, group=gPyramid)
enablePyramidOnPullback = input.bool(true, "Add Leg on Pullback Bounce (while trend intact)", group=gPyramid)

accountCapital       = input.float(30000, "Account Capital", minval=1, group=gCapital)
riskPerLegPct        = input.float(1.0, "Risk % of Capital Per Leg", minval=0.1, maxval=10.0, step=0.1, group=gCapital)
maxCapitalDeployPct  = input.float(80.0, "Max Total Capital Deployed (%)", minval=10.0, maxval=100.0, step=5.0, group=gCapital)

// Set these to the actual venue/account assumptions. Zero disables that cost.
// Funding is an estimate per elapsed 8-hour interval, not historical exchange data.
feePctPerSide       = input.float(0.0, "Trading fee per side (%)", minval=0.0, step=0.001, group=gCosts)
slippagePctPerSide  = input.float(0.0, "Slippage per side (%)", minval=0.0, step=0.001, group=gCosts)
fundingPctPer8h     = input.float(0.0, "Funding cost per 8h (%)", minval=0.0, step=0.001, group=gCosts)

scoreThreshold = input.float(60.0, "Composite Score Threshold (gates READY)", minval=0.0, maxval=100.0, group=gScore)

// The model is calibrated for four-hour candles. Refuse other chart
// intervals rather than silently producing signals and holding-period stats
// with different semantics.
chartSeconds = timeframe.in_seconds()
if na(chartSeconds) or chartSeconds != 14400
    runtime.error("Crypto Trend Rider must be applied to a 4-hour (240-minute) chart.")

// ============================================================
// CORE SERIES
// ============================================================
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
emaMajor = ta.ema(close, emaMajorLen)

[diPlus, diMinus, adxValue] = ta.dmi(adxLen, adxLen)
rsiValue = ta.rsi(close, rsiLen)

volAvg  = ta.sma(volume, volAvgLen)
volGood = volume > volAvg * volMultiplier

atrValue           = ta.atr(chandelierLen)
chandelierCandidate = ta.highest(high, chandelierLen) - atrValue * chandelierMult

trendStackBull = emaFast > emaSlow and emaSlow > emaMajor
trendUp        = trendStackBull and close > emaMajor
diBull         = diPlus > diMinus
adxStrong      = adxValue > adxThreshold

// ============================================================
// SCORING
// ============================================================
f_trendScore(stack, aboveMajor, aboveFast, diOk) =>
    float s = 0.0
    s += stack ? 40.0 : 0.0
    s += aboveMajor ? 20.0 : 0.0
    s += aboveFast ? 20.0 : 0.0
    s += diOk ? 20.0 : 0.0
    s

f_momentumScore(adxVal, adxThresh, rsiVal, rsiRising) =>
    float s = 0.0
    s += adxVal > adxThresh ? 40.0 : (adxVal > adxThresh * 0.75 ? 20.0 : 0.0)
    s += rsiVal > 50 ? 30.0 : 0.0
    s += rsiRising ? 30.0 : 0.0
    s

f_volumeScore(vol, avg, mult, rising) =>
    float s = 0.0
    s += vol > avg * mult ? 50.0 : (vol > avg ? 25.0 : 0.0)
    s += rising ? 50.0 : 0.0
    s

getScoreColor(score) =>
    color result = color.orange
    if score >= 80
        result := color.lime
    else if score >= 60
        result := color.teal
    else if score >= 35
        result := color.yellow
    result

trendScoreLive     = f_trendScore(trendStackBull, close > emaMajor, close > emaFast, diBull)
momentumScoreLive  = f_momentumScore(adxValue, adxThreshold, rsiValue, rsiValue > rsiValue[1])
volumeScoreLive    = f_volumeScore(volume, volAvg, volMultiplier, volume > volume[1])
compositeScoreLive = (trendScoreLive + momentumScoreLive + volumeScoreLive) / 3.0

// ============================================================
// TRADE STATE
// ============================================================
var float[] legEntry        = array.new_float(0)
var float[] legInitSL       = array.new_float(0)
var float[] legRisk         = array.new_float(0)
var float[] legQtyOriginal  = array.new_float(0)
var float[] legQtyRemaining = array.new_float(0)
var bool[]  legPartialDone  = array.new_bool(0)
var int[]   legEntryBar     = array.new_int(0)
var float[] legEntryTime    = array.new_float(0)
var float[] legTrend        = array.new_float(0)
var float[] legMomentum     = array.new_float(0)
var float[] legVolume          = array.new_float(0)
var float[] legRealizedPnlCcy   = array.new_float(0)
var float[] legEntryCostCcy     = array.new_float(0)

var float totalCapitalDeployed = 0.0
var float firstEntryTimeGlobal = na
var float lastExitTimeGlobal   = na
var float lastBatchExitPrice   = na

wasInTrade = array.size(legEntry) > 0

// Ratchet the long Chandelier stop upward while a position is open. Use the
// PREVIOUS bar's stop for this bar's stop test so today's high/ATR cannot
// retroactively move a stop above today's low.
var float chandelierLine = na
if barstate.isconfirmed
    chandelierLine := wasInTrade ? (na(chandelierLine[1]) ? chandelierCandidate : math.max(chandelierLine[1], chandelierCandidate)) : chandelierCandidate

float stopForBar = na
if wasInTrade
    stopForBar := array.get(legInitSL, 0)
    if not na(chandelierLine[1])
        stopForBar := math.max(stopForBar, chandelierLine[1])
    for i = 0 to array.size(legInitSL) - 1
        stopForBar := math.max(stopForBar, array.get(legInitSL, i))

stopHit = barstate.isconfirmed and wasInTrade and not na(stopForBar) and low <= stopForBar
stopFillPrice = stopHit ? (open < stopForBar ? open : stopForBar) : na
trendBreakExit = barstate.isconfirmed and useEmaCrossExit and ta.crossunder(emaFast, emaSlow)
entryAllowed = not stopHit and not trendBreakExit

// WATCH: building - price above the major trend EMA, ADX climbing, but
// the fast/slow/major stack isn't fully aligned yet.
watchCondition = not wasInTrade and close > emaMajor and not trendUp and adxValue > adxThreshold * 0.5

// READY: full trend alignment + strength confirmed, waiting on an actual
// entry trigger (the EMA cross-up).
readyCondition = not wasInTrade and trendUp and adxStrong and diBull and compositeScoreLive >= scoreThreshold

watchTriggered = barstate.isconfirmed and watchCondition and not watchCondition[1]
readyTriggered = barstate.isconfirmed and readyCondition and not readyCondition[1]

// ============================================================
// POSITION SIZING
// ============================================================
riskAmountCcy  = accountCapital * riskPerLegPct / 100.0
capitalCeiling = accountCapital * maxCapitalDeployPct / 100.0

f_qtyFor(entryP, slP) =>
    r = entryP - slP
    r > 0 ? math.floor(riskAmountCcy / r) : 0.0

// ============================================================
// ENTRY TRIGGERS
// ============================================================
emaCrossUp = ta.crossover(emaFast, emaSlow)
firstEntryTrigger = barstate.isconfirmed and not wasInTrade and emaCrossUp and close > emaMajor and diBull and adxValue > adxThreshold * 0.75 and volGood

pullbackTouch = trendUp and low <= emaFast * (1 + pullbackBandPct / 100.0)
addTrigger = barstate.isconfirmed and enablePyramidOnPullback and wasInTrade and trendUp and adxStrong and diBull and ta.crossover(close, emaFast) and pullbackTouch[1]

potentialSL      = math.min(chandelierLine, low)
potentialQty     = f_qtyFor(close, potentialSL)
potentialCapital = potentialQty * close

canAddLeg = array.size(legEntry) < maxPyramidLegs and potentialQty > 0 and
     (totalCapitalDeployed + potentialCapital) <= capitalCeiling

firstEntrySignal = firstEntryTrigger and canAddLeg and entryAllowed
addSignal         = addTrigger and canAddLeg and entryAllowed
buySignal         = firstEntrySignal or addSignal
legCapReached     = (firstEntryTrigger or addTrigger) and not canAddLeg and entryAllowed

if buySignal
    entryP = close
    slP    = potentialSL
    riskA  = entryP - slP
    qtyV   = potentialQty
    capV   = potentialCapital

    array.push(legEntry, entryP)
    array.push(legInitSL, slP)
    array.push(legRisk, riskA)
    array.push(legQtyOriginal, qtyV)
    array.push(legQtyRemaining, qtyV)
    array.push(legPartialDone, false)
    array.push(legEntryBar, bar_index)
    array.push(legEntryTime, time_close)
    array.push(legRealizedPnlCcy, 0.0)
    array.push(legEntryCostCcy, entryP * qtyV * (feePctPerSide + slippagePctPerSide) / 100.0)
    array.push(legTrend, trendScoreLive)
    array.push(legMomentum, momentumScoreLive)
    array.push(legVolume, volumeScoreLive)

    totalCapitalDeployed := totalCapitalDeployed + capV
    if na(firstEntryTimeGlobal)
        firstEntryTimeGlobal := time_close

// ============================================================
// STATS ENGINE
// ============================================================
var float[] tradePnlPct       = array.new_float(0)
var float[] tradePnlCcy       = array.new_float(0)
var float[] tradeRMultiple    = array.new_float(0)
var float[] tradeDurationBars = array.new_float(0)
var float   cumPnlCcy         = 0.0

var bool  partialTriggeredThisBar = false
partialTriggeredThisBar := false

// ---- PARTIAL PROFIT TARGET (per open leg) ----
// Stop/EMA exits take priority if both a stop and a target are touched in one bar.
// Target fills use the target price, or the opening price after a favourable gap.
if enablePartialTarget and wasInTrade and barstate.isconfirmed and not stopHit and not trendBreakExit
    for i = 0 to array.size(legEntry) - 1
        if not array.get(legPartialDone, i) and bar_index > array.get(legEntryBar, i)
            entryP  = array.get(legEntry, i)
            riskA   = array.get(legRisk, i)
            targetP = entryP + riskA * partialRR
            if riskA > 0 and high >= targetP
                qtyOrig   = array.get(legQtyOriginal, i)
                qtyRemain = array.get(legQtyRemaining, i)
                scaleQty  = math.min(qtyOrig * partialPct / 100.0, qtyRemain)
                fillPrice = open > targetP ? open : targetP
                entryCost = array.get(legEntryCostCcy, i) * scaleQty / qtyOrig
                exitCost  = fillPrice * scaleQty * (feePctPerSide + slippagePctPerSide) / 100.0
                heldMs    = math.max(time_close - array.get(legEntryTime, i), 0)
                fundingIntervals = math.floor(heldMs / 28800000.0)
                fundingCost = entryP * scaleQty * fundingPctPer8h / 100.0 * fundingIntervals
                pnlCcy = (fillPrice - entryP) * scaleQty - entryCost - exitCost - fundingCost

                array.set(legRealizedPnlCcy, i, array.get(legRealizedPnlCcy, i) + pnlCcy)
                cumPnlCcy := cumPnlCcy + pnlCcy
                totalCapitalDeployed := totalCapitalDeployed - scaleQty * entryP
                array.set(legQtyRemaining, i, qtyRemain - scaleQty)
                array.set(legPartialDone, i, true)
                partialTriggeredThisBar := true

// ---- FULL EXIT (all remaining legs) ----
// The shared stop is the tightest of the ratcheted Chandelier and all open
// legs' initial stops. A gap below it is filled at the bar open; otherwise
// the stop is assumed filled at its level. EMA exits are close-based.
sellSignal = barstate.isconfirmed and wasInTrade and (trendBreakExit or stopHit)
exitPrice = stopHit ? stopFillPrice : close

var float lastBatchPnlCcy   = na
var int   lastBatchLegCount = 0

if sellSignal
    lastBatchLegCount := array.size(legEntry)
    float batchNewPnlCcy = 0.0
    float batchTotalPnlCcy = 0.0
    for i = 0 to array.size(legEntry) - 1
        entryP    = array.get(legEntry, i)
        riskA     = array.get(legRisk, i)
        qtyOrig   = array.get(legQtyOriginal, i)
        qtyRemain = array.get(legQtyRemaining, i)
        remainingEntryCost = array.get(legEntryCostCcy, i) * qtyRemain / qtyOrig
        remainingExitCost  = exitPrice * qtyRemain * (feePctPerSide + slippagePctPerSide) / 100.0
        heldMs = math.max(time_close - array.get(legEntryTime, i), 0)
        fundingIntervals = math.floor(heldMs / 28800000.0)
        remainingFundingCost = entryP * qtyRemain * fundingPctPer8h / 100.0 * fundingIntervals
        remainingNetPnl = (exitPrice - entryP) * qtyRemain - remainingEntryCost - remainingExitCost - remainingFundingCost
        legTotalNetPnl = array.get(legRealizedPnlCcy, i) + remainingNetPnl
        pnlPct = entryP * qtyOrig > 0 ? legTotalNetPnl / (entryP * qtyOrig) * 100.0 : na
        rMult = riskA * qtyOrig > 0 ? legTotalNetPnl / (riskA * qtyOrig) : na

        array.push(tradePnlPct, pnlPct)
        array.push(tradePnlCcy, legTotalNetPnl)
        array.push(tradeRMultiple, rMult)
        array.push(tradeDurationBars, float(bar_index - array.get(legEntryBar, i)))

        batchNewPnlCcy += remainingNetPnl
        batchTotalPnlCcy += legTotalNetPnl

    cumPnlCcy := cumPnlCcy + batchNewPnlCcy
    lastBatchPnlCcy := batchTotalPnlCcy
    lastBatchExitPrice := exitPrice
    lastExitTimeGlobal := time_close
    totalCapitalDeployed := 0.0

    array.clear(legEntry)
    array.clear(legInitSL)
    array.clear(legRisk)
    array.clear(legQtyOriginal)
    array.clear(legQtyRemaining)
    array.clear(legPartialDone)
    array.clear(legEntryBar)
    array.clear(legEntryTime)
    array.clear(legTrend)
    array.clear(legMomentum)
    array.clear(legVolume)
    array.clear(legRealizedPnlCcy)
    array.clear(legEntryCostCcy)

totalTrades = array.size(tradePnlCcy)   // completed legs; partial exits are rolled into each leg result

var float winCount        = 0.0
var float sumPnlCcy       = 0.0
var float sumWinCcy       = 0.0
var float sumLossCcy      = 0.0
var float winCountForAvg  = 0.0
var float lossCountForAvg = 0.0
var float bestTradeCcy    = na
var float worstTradeCcy   = na
var float sumR            = 0.0
var int   rCount          = 0
var float maxDDCcy        = 0.0
var float avgWinCcy       = na
var float avgLossCcy      = na
var float profitFactor    = na
var float avgR            = na
var float avgHoldingBars  = na

if barstate.islast and totalTrades > 0
    winCount        := 0.0
    sumPnlCcy       := 0.0
    sumWinCcy       := 0.0
    sumLossCcy      := 0.0
    winCountForAvg  := 0.0
    lossCountForAvg := 0.0
    bestTradeCcy    := array.get(tradePnlCcy, 0)
    worstTradeCcy   := array.get(tradePnlCcy, 0)
    sumR            := 0.0
    rCount          := 0
    maxDDCcy        := 0.0

    float cumEquity  = 0.0
    float peakEquity = 0.0
    float sumDurBars = 0.0

    for i = 0 to totalTrades - 1
        p = array.get(tradePnlCcy, i)
        sumPnlCcy += p
        if p > 0
            winCount       += 1
            sumWinCcy      += p
            winCountForAvg += 1
        else if p < 0
            sumLossCcy      += p
            lossCountForAvg += 1

        if p > bestTradeCcy
            bestTradeCcy := p
        if p < worstTradeCcy
            worstTradeCcy := p

        rVal = array.get(tradeRMultiple, i)
        if not na(rVal)
            sumR += rVal
            rCount += 1

        sumDurBars += array.get(tradeDurationBars, i)

        cumEquity += p
        if cumEquity > peakEquity
            peakEquity := cumEquity
        dd = peakEquity - cumEquity
        if dd > maxDDCcy
            maxDDCcy := dd

    avgWinCcy      := winCountForAvg  > 0 ? sumWinCcy / winCountForAvg   : na
    avgLossCcy     := lossCountForAvg > 0 ? sumLossCcy / lossCountForAvg : na
    profitFactor   := (lossCountForAvg > 0 and sumLossCcy != 0) ? sumWinCcy / math.abs(sumLossCcy) : na
    avgR           := rCount > 0 ? sumR / rCount : na
    avgHoldingBars := sumDurBars / totalTrades

winRate = totalTrades > 0 ? winCount / totalTrades * 100 : na

// ============================================================
// STATUS MODEL
// ============================================================
openLegCount  = array.size(legEntry)
mostRecentIdx = openLegCount - 1

statusText  = sellSignal ? "SELL (all legs)" : firstEntrySignal ? "BUY" : addSignal ? "ADD (leg " + str.tostring(openLegCount) + ")" : legCapReached ? "TRIGGER (cap reached)" : partialTriggeredThisBar ? "PARTIAL TARGET HIT" : wasInTrade ? "IN TRADE (" + str.tostring(openLegCount) + " legs)" : readyCondition ? "READY" : watchCondition ? "WATCH" : "IGNORE"
statusColor = sellSignal ? color.red : firstEntrySignal ? color.lime : addSignal ? color.aqua : legCapReached ? color.orange : partialTriggeredThisBar ? color.teal : wasInTrade ? color.green : readyCondition ? color.aqua : watchCondition ? color.yellow : color.silver

recCategory = firstEntrySignal ? "BUY" : addSignal ? "ADD" : legCapReached ? "IGNORE" : readyCondition ? "READY" : watchCondition ? "WATCH" : "IGNORE"

f_recommendationReason(cat, capHit) =>
    string txt = ""
    if cat == "BUY"
        txt := "Trend confirmed - EMA cross-up above major EMA, ADX strong"
    else if cat == "ADD"
        txt := "Pullback to fast EMA bounced - trend still intact"
    else if capHit
        txt := "Entry trigger fired but capital/leg cap blocked it"
    else if cat == "READY"
        txt := "EMA stack aligned, ADX strong - waiting for cross-up"
    else if cat == "WATCH"
        txt := "Above major trend EMA, ADX building - stack not aligned yet"
    else
        txt := "No trend edge here"
    txt

recReason = f_recommendationReason(recCategory, legCapReached)

displayTrend    = openLegCount > 0 ? array.get(legTrend, mostRecentIdx)    : trendScoreLive
displayMomentum = openLegCount > 0 ? array.get(legMomentum, mostRecentIdx) : momentumScoreLive
displayVolume   = openLegCount > 0 ? array.get(legVolume, mostRecentIdx)   : volumeScoreLive

displayStop = wasInTrade and not na(stopForBar) ? stopForBar : chandelierLine
distToStopPct = close != 0 and not na(displayStop) ? (close - displayStop) / close * 100.0 : na

// ============================================================
// VISUALS
// ============================================================
bgcolor(openLegCount > 0 ? color.new(color.green, 92) : na, title="Active Trade Zone")

plot(emaFast, "Fast EMA", color=color.new(color.aqua, 20), linewidth=1)
plot(emaSlow, "Slow EMA", color=color.new(color.orange, 20), linewidth=1)
plot(emaMajor, "Major Trend EMA", color=color.new(color.gray, 30), linewidth=2)
plot(chandelierLine, "Chandelier Trailing Stop", color=color.new(color.red, 20), style=plot.style_circles, linewidth=1)

plotshape(firstEntrySignal, title="BUY (1st leg)", style=shape.triangleup, location=location.belowbar,
     color=color.new(color.lime, 0), size=size.tiny)
plotshape(addSignal, title="ADD (pullback leg)", style=shape.diamond, location=location.belowbar,
     color=color.new(color.aqua, 0), size=size.tiny)
plotshape(partialTriggeredThisBar, title="Partial Target Hit", style=shape.circle, location=location.abovebar,
     color=color.new(color.teal, 0), size=size.tiny)
plotshape(sellSignal, title="SELL (all legs)", style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 0), size=size.tiny)

if firstEntrySignal
    label.new(bar_index, low, "BUY " + str.tostring(close, "#.####") +
         " x" + str.tostring(array.get(legQtyOriginal, mostRecentIdx), "#.##") +
         "\nT" + str.tostring(array.get(legTrend, mostRecentIdx), "#") +
         " M" + str.tostring(array.get(legMomentum, mostRecentIdx), "#") +
         " V" + str.tostring(array.get(legVolume, mostRecentIdx), "#"),
         style=label.style_label_up, color=color.new(color.lime, 0),
         textcolor=color.black, size=size.tiny)

if addSignal
    label.new(bar_index, low, "ADD leg " + str.tostring(openLegCount) + "\n@" + str.tostring(close, "#.####") +
         " x" + str.tostring(array.get(legQtyOriginal, mostRecentIdx), "#.##"),
         style=label.style_label_up, color=color.new(color.aqua, 0),
         textcolor=color.black, size=size.tiny)

if sellSignal
    pnlText = (lastBatchPnlCcy >= 0 ? "+" : "") + str.tostring(lastBatchPnlCcy, "#.##")
    label.new(bar_index, high, "SELL " + str.tostring(lastBatchExitPrice, "#.####") + " (" + str.tostring(lastBatchLegCount) + " legs)\n" + pnlText,
         style=label.style_label_down,
         color=color.new(lastBatchPnlCcy >= 0 ? color.green : color.red, 0),
         textcolor=color.white, size=size.tiny)

if barstate.isconfirmed and watchTriggered
    label.new(bar_index, high, "WATCH", style=label.style_label_down, color=color.new(color.yellow, 0),
         textcolor=color.black, size=size.tiny)

if barstate.isconfirmed and readyTriggered
    label.new(bar_index, high, "READY\nT" + str.tostring(trendScoreLive, "#") +
         " M" + str.tostring(momentumScoreLive, "#") +
         " V" + str.tostring(volumeScoreLive, "#"),
         style=label.style_label_down, color=color.new(color.aqua, 0),
         textcolor=color.black, size=size.tiny)

// ============================================================
// DASHBOARD
// ============================================================
f_row(t, rowIdx, label, value, valColor) =>
    table.cell(t, 0, rowIdx, label, text_color=color.gray, text_size=size.small)
    table.cell(t, 1, rowIdx, value, text_color=valColor, text_size=size.small)

f_header(t, rowIdx, label, value, valColor) =>
    table.cell(t, 0, rowIdx, label, text_color=color.white, bgcolor=color.new(color.gray, 40), text_size=size.small)
    table.cell(t, 1, rowIdx, value, text_color=valColor, bgcolor=color.new(color.gray, 40), text_size=size.small)

var table infoTable = table.new(position.top_right, 2, 40, bgcolor=color.new(color.black, 70), border_width=1)

if barstate.islast
    f_header(infoTable, 0, "TREND DASHBOARD", statusText, statusColor)
    f_row(infoTable, 1, "Trend Score", str.tostring(displayTrend, "#.#") + " / 100", getScoreColor(displayTrend))
    f_row(infoTable, 2, "Momentum Score", str.tostring(displayMomentum, "#.#") + " / 100", getScoreColor(displayMomentum))
    f_row(infoTable, 3, "Volume Score", str.tostring(displayVolume, "#.#") + " / 100", getScoreColor(displayVolume))
    f_row(infoTable, 4, "ADX", str.tostring(adxValue, "#.#") + (adxStrong ? " (strong)" : " (weak)"), adxStrong ? color.lime : color.gray)
    f_row(infoTable, 5, "Dist. to Trailing Stop", str.tostring(distToStopPct, "#.#") + "%", distToStopPct > 0 ? color.lime : color.red)
    f_row(infoTable, 6, "Recommendation", recCategory + " - " + recReason, statusColor)
    f_row(infoTable, 7, "Fee / slip / funding per 8h", str.tostring(feePctPerSide, "#.###") + "% / " + str.tostring(slippagePctPerSide, "#.###") + "% / " + str.tostring(fundingPctPer8h, "#.###") + "%", color.silver)

    f_header(infoTable, 8, "OPEN LEGS", str.tostring(openLegCount) + " / " + str.tostring(maxPyramidLegs), openLegCount > 0 ? color.lime : color.silver)

    for i = 0 to maxPyramidLegs - 1
        rowIdx = 9 + i
        if i < openLegCount
            legText = "#" + str.tostring(i + 1) + ": " + str.tostring(array.get(legEntry, i), "#.####") +
                 " x" + str.tostring(array.get(legQtyRemaining, i), "#.##") +
                 " | SL " + str.tostring(array.get(legInitSL, i), "#.####") +
                 (array.get(legPartialDone, i) ? " | partial taken" : "")
            f_row(infoTable, rowIdx, "Leg " + str.tostring(i + 1), legText, color.white)
        else
            f_row(infoTable, rowIdx, "Leg " + str.tostring(i + 1), "-", color.gray)

    statsHeaderRow = 9 + maxPyramidLegs
    f_header(infoTable, statsHeaderRow, "HISTORY", "(" + str.tostring(totalTrades) + " completed legs)", color.silver)
    f_row(infoTable, statsHeaderRow + 1, "Net P&L (currency)", (totalTrades > 0 or cumPnlCcy != 0) ? (cumPnlCcy >= 0 ? "+" : "") + str.tostring(cumPnlCcy, "#.##") : "-", cumPnlCcy >= 0 ? color.lime : color.red)
    f_row(infoTable, statsHeaderRow + 2, "Win Rate", totalTrades > 0 ? str.tostring(winRate, "#.#") + "%" : "-", color.white)
    f_row(infoTable, statsHeaderRow + 3, "Avg Win / Avg Loss", totalTrades > 0 ? (na(avgWinCcy) ? "-" : "+" + str.tostring(avgWinCcy, "#.##")) + " / " + (na(avgLossCcy) ? "-" : str.tostring(avgLossCcy, "#.##")) : "-", color.white)
    f_row(infoTable, statsHeaderRow + 4, "Profit Factor", totalTrades > 0 ? (na(profitFactor) ? "∞" : str.tostring(profitFactor, "#.##")) : "-", (na(profitFactor) or profitFactor >= 1) ? color.lime : color.red)
    f_row(infoTable, statsHeaderRow + 5, "Closed-leg drawdown (ccy)", totalTrades > 0 ? "-" + str.tostring(maxDDCcy, "#.##") : "-", color.red)
    f_row(infoTable, statsHeaderRow + 6, "Best / Worst Close", totalTrades > 0 ? "+" + str.tostring(bestTradeCcy, "#.##") + " / " + str.tostring(worstTradeCcy, "#.##") : "-", color.white)
    f_row(infoTable, statsHeaderRow + 7, "Avg R Multiple", totalTrades > 0 and not na(avgR) ? str.tostring(avgR, "#.##") + "R" : "-", (not na(avgR) and avgR >= 0) ? color.lime : color.red)
    f_row(infoTable, statsHeaderRow + 8, "Avg Holding (bars)", totalTrades > 0 ? str.tostring(avgHoldingBars, "#.#") : "-", color.white)
    f_row(infoTable, statsHeaderRow + 9, "Metrics", "Closed legs only; open/unrealized DD excluded", color.silver)

// ============================================================
// ALERTS
// ============================================================
alertcondition(barstate.isconfirmed and watchTriggered, title="Trend WATCH", message="{{ticker}}: Above major trend EMA, ADX building - watch for stack alignment")
alertcondition(barstate.isconfirmed and readyTriggered, title="Trend READY", message="{{ticker}}: EMA stack aligned + ADX strong - waiting for cross-up entry")
alertcondition(barstate.isconfirmed and firstEntrySignal, title="Trend BUY (1st leg)", message="{{ticker}}: Fast EMA crossed above slow EMA with trend + volume confirmation - first entry")
alertcondition(barstate.isconfirmed and addSignal, title="Trend ADD (pullback leg)", message="{{ticker}}: Pullback to fast EMA bounced while trend intact - leg added")
alertcondition(barstate.isconfirmed and legCapReached, title="Trend Trigger - Cap Reached", message="{{ticker}}: Entry trigger fired but leg count or capital cap blocked it")
alertcondition(barstate.isconfirmed and partialTriggeredThisBar, title="Partial Profit Target Hit", message="{{ticker}}: Partial target reached - scaled out a portion, remainder trailing")
alertcondition(barstate.isconfirmed and sellSignal, title="Trend Exit - SELL ALL LEGS", message="{{ticker}}: Trend break or trailing stop hit - exiting all open legs")
